{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fablesheet",
  "version": "../package.json",
  "identifier": "io.github.fablesheet.Fablesheet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fablesheet",
        "width": 1600,
        "height": 1000,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Offline-first character manager for 5th edition tabletop RPGs",
    "longDescription": "Fablesheet is a free, open-source, offline-first character manager for 5th edition tabletop roleplaying games. Create characters, track hit points, spells and inventory - all stored locally on your device.",
    "publisher": "Fablesheet contributors",
    "copyright": "Copyright \u00a9 2026 Fablesheet contributors. Licensed under GPL-3.0-or-later.",
    "linux": {},
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "license": "GPL-3.0-or-later"
  }
}
