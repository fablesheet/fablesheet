{
  "name": "fablesheet",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run tauri dev -w @fablesheet/desktop",
    "dev:web": "npm run dev -w @fablesheet/desktop",
    "build": "npm run build -w @fablesheet/desktop",
    "tauri": "npm run tauri -w @fablesheet/desktop --",
    "typecheck": "npm run typecheck -w @fablesheet/desktop",
    "server": "cargo run -p fablesheet-server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
